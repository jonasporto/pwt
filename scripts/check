#!/usr/bin/env bash
# Local verification pipeline: everything CI runs, plus what CI cannot.
#
#   scripts/check            # everything (default)
#   scripts/check fast       # syntax + lint + tests under one bash (pre-commit)
#   scripts/check lint       # linters only
#   scripts/check tests      # tests only, both bash versions
#   scripts/check coverage   # line coverage via kcov
#
# Every stage prints PASS/FAIL/SKIP and the run ends with a summary; blocking
# stages decide the exit code, informational ones only report. Missing tools
# SKIP rather than fail, so the script is useful on a fresh checkout.

set -uo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
BLUE=$'\033[0;34m'
DIM=$'\033[2m'
NC=$'\033[0m'

SOURCES=(bin/pwt lib/pwt/*.sh)
FAILED=""
SKIPPED=""
SUMMARY=""

stage() { printf '\n%s▸ %s%s\n' "$BLUE" "$1" "$NC"; }
pass() {
    printf '  %s✓%s %s\n' "$GREEN" "$NC" "$1"
    SUMMARY+="  ${GREEN}✓${NC} $1"$'\n'
}
fail() {
    printf '  %s✗%s %s\n' "$RED" "$NC" "$1"
    SUMMARY+="  ${RED}✗${NC} $1"$'\n'
    FAILED="${FAILED}$1"$'\n'
}
info() {
    printf '  %s•%s %s\n' "$YELLOW" "$NC" "$1"
    SUMMARY+="  ${YELLOW}•${NC} $1"$'\n'
}
skip() {
    printf '  %s—%s %s\n' "$DIM" "$NC" "$1"
    SUMMARY+="  ${DIM}—${NC} $1"$'\n'
    SKIPPED="${SKIPPED}$1"$'\n'
}

have() { command -v "$1" >/dev/null 2>&1; }

# --- stages ---------------------------------------------------------------

check_syntax() {
    stage "Syntax (bash -n)"
    local f bad=0
    for f in "${SOURCES[@]}" completions/pwt.bash scripts/*; do
        [ -f "$f" ] || continue
        case "$f" in *.fish | *_pwt) continue ;; esac
        bash -n "$f" 2>/dev/null || {
            echo "      $f"
            bad=1
        }
    done
    [ "$bad" -eq 0 ] && pass "syntax" || fail "syntax"
}

check_shellcheck() {
    stage "ShellCheck"
    if ! have shellcheck; then
        skip "shellcheck (not installed)"
        return
    fi

    if shellcheck -x -S error "${SOURCES[@]}"; then
        pass "shellcheck -S error (blocking gate)"
    else
        fail "shellcheck -S error"
    fi

    local warns
    warns=$(shellcheck -x -S warning -f gcc "${SOURCES[@]}" 2>/dev/null | wc -l | tr -d ' ')
    info "shellcheck warnings: $warns (informational; see docs/quality.md)"
}

check_format() {
    stage "Formatting (shfmt)"
    if ! have shfmt; then
        skip "shfmt (brew install shfmt)"
        return
    fi

    local unformatted
    # No printer flags: passing any of them disables .editorconfig
    unformatted=$(shfmt -l "${SOURCES[@]}" completions/pwt.bash 2>/dev/null | wc -l | tr -d ' ')
    if [ "$unformatted" -eq 0 ]; then
        pass "shfmt (all files formatted)"
    else
        # A gate since the 2026-08-09 reformat: the backlog is zero, so any
        # drift is new and cheap to fix.
        fail "shfmt: $unformatted file(s) unformatted — run 'shfmt -w .'"
        shfmt -l "${SOURCES[@]}" completions/pwt.bash 2>/dev/null | sed 's/^/      /'
    fi
}

# Distinguish "tests failed" from "the run died": a run killed by a signal
# exits non-zero with zero `not ok` lines, and reporting that as "0 failing"
# hides the real problem. Counts scripts/test.sh per-FILE result lines
# ("ok tests/foo.bats (4s)"); failing files dump their full bats log below.
_report_bats() {
    local rc="$1" log="$2" label="$3" passed failed
    passed=$(grep -c '^ok tests/' "$log" 2>/dev/null || true)
    passed=${passed:-0}
    failed=$(grep -c '^not ok tests/' "$log" 2>/dev/null || true)
    failed=${failed:-0}

    if [ "$rc" -eq 0 ]; then
        pass "$label ($passed files)"
    elif [ "$failed" -gt 0 ]; then
        fail "$label ($failed failing file(s) of $((passed + failed)))"
        grep -E '^not ok tests/' "$log" | head -10
    else
        fail "$label (run aborted: exit $rc after $passed files - see $log)"
    fi
}

check_tests() {
    local both="${1:-both}"
    stage "Tests (bats)"
    if ! have bats; then
        fail "bats not installed"
        return
    fi

    local rc
    # scripts/test.sh parallelizes across .bats files (~2min instead of the
    # ~6.5min serial pass that used to make the pre-push hook outlive
    # GitHub's SSH idle window).
    scripts/test.sh >/tmp/pwt-check-tests.log 2>&1
    rc=$?
    _report_bats "$rc" /tmp/pwt-check-tests.log \
        "bats under bash $(bash --version | head -1 | grep -oE '[0-9]+\.[0-9]+' | head -1)"

    [ "$both" = both ] || return

    # macOS system bash swallows failing [[ ]] mid-test; pwt itself always
    # runs under it (shebang), so the 3.2 pass is the compatibility check.
    if [ "$(uname -s)" = Darwin ] && [ -x /bin/bash ]; then
        local v32
        v32=$(/bin/bash --version | head -1 | grep -oE '[0-9]+\.[0-9]+' | head -1)
        local rc32
        PWT_TEST_BASH=/bin/bash scripts/test.sh >/tmp/pwt-check-32.log 2>&1
        rc32=$?
        _report_bats "$rc32" /tmp/pwt-check-32.log "bats under system bash $v32"
    fi
}

check_coverage() {
    stage "Coverage (kcov)"
    if ! have kcov; then
        skip "kcov (brew install kcov)"
        return
    fi

    # Delegates to scripts/coverage, which owns the kcov invocation
    exec_out=$("$PWD/scripts/coverage" 2>&1) || true
    printf '%s\n' "$exec_out" | tail -2 | sed 's/^/  /'
    return 0
}

check_docs() {
    stage "Docs consistency"
    local problems=0

    # Every subcommand must appear in the man page. Both tokens must land on
    # the SAME line, or this passes on any mention of "state"/"server"/"jobs"
    # - which is what the first version of this check actually did.
    local pair verb sub
    for pair in "state:migrate" "server:wait" "jobs:wait" "jobs:porcelain"; do
        verb="${pair%%:*}"
        sub="${pair##*:}"
        # No \b here: BSD grep (macOS) lacks it, and this script must behave
        # identically on both platforms.
        if ! grep -E "^\.B .*${verb}.*${sub}" man/pwt.1 >/dev/null; then
            echo "      man page missing: $verb $sub"
            problems=1
        fi
    done

    # Version consistency across the three places that declare it
    local v_bin v_pkg v_readme
    v_bin=$(grep -m1 'PWT_VERSION=' bin/pwt | cut -d'"' -f2)
    v_pkg=$(grep -m1 '"version"' package.json | cut -d'"' -f4)
    v_readme=$(grep -m1 -oE 'version-[0-9.]+-green' README.md | grep -oE '[0-9.]+')
    local v_man
    v_man=$(grep -m1 '^\.TH PWT' man/pwt.1 | sed -E 's/.*"pwt ([0-9.]+)".*/\1/')
    if [ "$v_bin" != "$v_pkg" ] || [ "$v_bin" != "$v_readme" ] || [ "$v_bin" != "$v_man" ]; then
        echo "      version mismatch: bin=$v_bin package.json=$v_pkg README=$v_readme man=$v_man"
        problems=1
    fi

    # The website's documentation is generated from the binary's own help
    # output, so a CLI change that skips the help text shows up here as a
    # stale site/docs/ instead of silently shipping wrong documentation.
    if ! scripts/gen-docs --check >/dev/null 2>&1; then
        echo "      site/docs is stale: run scripts/gen-docs and commit"
        problems=1
    fi

    [ "$problems" -eq 0 ] && pass "docs (man coverage, version consistency, generated site docs)" || fail "docs"
}

# --- driver ---------------------------------------------------------------

main() {
    local mode="${1:-all}"
    local started
    started=$SECONDS

    case "$mode" in
        fast)
            check_syntax
            check_shellcheck
            check_format
            check_tests one
            ;;
        lint)
            check_syntax
            check_shellcheck
            check_format
            ;;
        tests)
            check_tests both
            ;;
        coverage)
            check_coverage
            ;;
        all)
            check_syntax
            check_shellcheck
            check_format
            check_docs
            check_tests both
            ;;
        -h | --help)
            sed -n '2,14p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
            return 0
            ;;
        *)
            echo "Unknown mode: $mode (try: all, fast, lint, tests, coverage)" >&2
            return 2
            ;;
    esac

    printf '\n%s── summary ─%s\n%s' "$BLUE" "$NC" "$SUMMARY"
    printf '%sran in %ss%s\n' "$DIM" "$((SECONDS - started))" "$NC"

    if [ -n "$FAILED" ]; then
        printf '\n%sFAILED%s\n' "$RED" "$NC"
        return 1
    fi
    printf '\n%sOK%s\n' "$GREEN" "$NC"
    return 0
}

main "$@"
